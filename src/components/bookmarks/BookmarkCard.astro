---
type Props = {
  title: string;
  url: string;
  description?: string;
  category?: string;
  tags?: string[];
};

const { title, url, description, category, tags = [] } = Astro.props;
let domain = "";
try {
  domain = new URL(url).hostname;
} catch {}
const favicon = domain ? `https://icons.duckduckgo.com/ip3/${domain}.ico` : "";
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="border-border bg-card flex gap-3 rounded-lg border p-3 transition hover:shadow-sm"
>
  {
    favicon ? (
      <img
        src={favicon}
        alt=""
        width="24"
        height="24"
        class="mt-0.5 size-6 shrink-0 rounded bg-white object-contain"
        loading="lazy"
      />
    ) : (
      <div class="bg-muted mt-0.5 size-6 shrink-0 rounded" />
    )
  }
  <div class="min-w-0 flex-1">
    <h3 class="truncate text-sm font-medium">{title}</h3>
    {
      description && (
        <p class="text-muted-foreground mt-0.5 line-clamp-2 text-xs">
          {description}
        </p>
      )
    }
    <p class="text-muted-foreground mt-1 truncate text-[11px]">{domain}</p>
    <div class="mt-1.5 flex flex-wrap gap-1">
      {
        category && (
          <span class="bg-accent/10 text-accent rounded px-1.5 py-0.5 text-[10px]">
            {category}
          </span>
        )
      }
      {
        tags.map(tag => (
          <span class="bg-muted rounded px-1.5 py-0.5 text-[10px]">{tag}</span>
        ))
      }
    </div>
  </div>
</a>
