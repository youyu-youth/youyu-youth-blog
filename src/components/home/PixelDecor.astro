---
/**
 * Pixel-art sparkles scattered around the hero. Purely decorative,
 * desktop-only. Colour follows the --deco design token.
 */
type Sparkle = {
  shape: "plus" | "diamond";
  left: string;
  top: string;
  size: number;
  opacity: number;
};

const SHAPES: Record<Sparkle["shape"], string> = {
  plus: "M2 0h1v2h2v1H3v2H2V3H0V2h2z",
  diamond: "M2 0l2 2-2 2-2-2z",
};

const sparkles: Sparkle[] = [];
---

<div
  aria-hidden="true"
  class="text-deco pointer-events-none absolute inset-0 hidden lg:block"
>
  {
    sparkles.map(({ shape, left, top, size, opacity }) => (
      <svg
        viewBox="0 0 5 5"
        width={size}
        height={size}
        class="absolute"
        style={`left:${left};top:${top};opacity:${opacity}`}
        shape-rendering="crispEdges"
      >
        <path fill="currentColor" d={SHAPES[shape]} />
      </svg>
    ))
  }
</div>
