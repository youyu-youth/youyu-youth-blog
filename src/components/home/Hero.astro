---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import IconMapPin from "@/assets/icons/IconMapPin.svg";
import IconUser from "@/assets/icons/IconUser.svg";
import IconGitHub from "@/assets/icons/socials/github.svg";
import PixelDecor from "./PixelDecor.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, socials } = config;

const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);

// Avatar lives in src/assets/images (config.site.avatar is the filename).
// Falls back to a placeholder initial when unset or missing.
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{png,jpg,jpeg,webp,avif}",
  { eager: true }
);
const avatar = site.avatar
  ? images[`/src/assets/images/${site.avatar}`]?.default
  : undefined;

const github = socials.find(({ name }) => name.toLowerCase() === "github");
---

<section
  id="hero"
  class="border-border relative border-b pt-12 pb-10 sm:pt-16 sm:pb-14"
>
  <PixelDecor />

  <div class="flex flex-col items-center text-center">
    {
      avatar ? (
        <Image
          src={avatar}
          alt={site.author}
          width={112}
          height={112}
          class="ring-deco ring-offset-background size-28 rounded-full object-cover ring-2 ring-offset-4"
        />
      ) : (
        <div
          aria-hidden="true"
          class="ring-deco ring-offset-background bg-muted text-accent grid size-28 place-items-center rounded-full text-4xl font-bold ring-2 ring-offset-4"
        >
          {site.title.charAt(0)}
        </div>
      )
    }

    <h1 class="mt-6 text-4xl font-bold tracking-widest sm:text-5xl">
      {site.title}
    </h1>

    <p class="text-muted-foreground mt-4 text-base sm:text-lg">
      {t.home.heroTagline}
    </p>

    <span
      aria-hidden="true"
      class="text-deco mt-6 block size-2 rotate-45 bg-current"></span>

    <ul
      class="text-muted-foreground mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm"
    >
      <li class="flex items-center gap-1.5">
        <IconMapPin class="text-deco size-4" />
        {t.home.heroLocation}
      </li>
      <li class="flex items-center gap-1.5">
        <IconUser class="text-deco size-4" />
        {t.home.heroRole}
      </li>
      {
        github && (
          <li>
            <a
              href={github.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent flex items-center gap-1.5 transition-colors"
            >
              <IconGitHub class="text-deco size-4" />
              GitHub
            </a>
          </li>
        )
      }
    </ul>
  </div>

  {
    t.home.heroQuote && (
      <figure class="text-muted-foreground absolute top-1/2 right-0 hidden w-44 -translate-y-1/2 text-sm lg:block">
        <span aria-hidden="true" class="text-deco text-lg leading-none">
          &ldquo;
        </span>
        <blockquote class="mt-1 whitespace-pre-line italic">
          {t.home.heroQuote}
        </blockquote>
        {t.home.heroQuoteAuthor && (
          <figcaption class="mt-2 not-italic">
            — {t.home.heroQuoteAuthor}
          </figcaption>
        )}
      </figure>
    )
  }
</section>
