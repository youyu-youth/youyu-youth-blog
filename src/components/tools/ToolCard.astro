---
type Props = {
  name: string;
  url: string;
  description?: string;
  category?: string;
  icon?: string;
  variant?: "accent" | "inverted" | "muted" | "card";
};

const { name, url, description, category, icon, variant = "card" } = Astro.props;

let domain = "";
try {
  domain = new URL(url).hostname.replace(/^www\./, "");
} catch {}

const favicon =
  icon || (domain ? `https://icons.duckduckgo.com/ip3/${domain}.ico` : "");

const variantClasses: Record<NonNullable<Props["variant"]>, string> = {
  accent: "bg-accent text-accent-foreground border-accent",
  inverted: "bg-foreground text-background border-foreground",
  muted: "bg-muted text-foreground border-transparent",
  card: "bg-card text-foreground border-border",
};

const pillClasses: Record<NonNullable<Props["variant"]>, string> = {
  accent: "bg-white/15 text-accent-foreground border-white/20",
  inverted: "bg-white/10 text-background border-white/15",
  muted: "bg-background text-muted-foreground border-border",
  card: "bg-muted text-muted-foreground border-transparent",
};

const descClasses: Record<NonNullable<Props["variant"]>, string> = {
  accent: "text-accent-foreground/80",
  inverted: "text-background/70",
  muted: "text-muted-foreground",
  card: "text-muted-foreground",
};

const domainClasses: Record<NonNullable<Props["variant"]>, string> = {
  accent: "text-accent-foreground/60",
  inverted: "text-background/50",
  muted: "text-muted-foreground",
  card: "text-muted-foreground",
};

const isDarkCard = variant === "accent" || variant === "inverted";
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "group flex min-h-[168px] flex-col rounded-lg border p-5 transition duration-300 ease-[0.16,1,0.3,1] hover:-translate-y-0.5 active:scale-[0.98] active:translate-y-0",
    variantClasses[variant],
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2.5">
      {
        favicon ? (
          <img
            src={favicon}
            alt=""
            width="36"
            height="36"
            class="size-9 shrink-0 rounded-md border border-black/5 bg-white object-contain p-1.5"
            loading="lazy"
            onerror="this.style.display='none'"
          />
        ) : (
          <div class="bg-muted flex size-9 shrink-0 items-center justify-center rounded-md border border-border font-mono text-xs font-medium">
            {name.slice(0, 1)}
          </div>
        )
      }
      {
        category && (
          <span
            class:list={[
              "inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-medium leading-none",
              pillClasses[variant],
            ]}
          >
            {category}
          </span>
        )
      }
    </div>
    <span
      class:list={[
        "mt-1 inline-flex size-7 shrink-0 items-center justify-center rounded-full border transition group-hover:translate-x-0.5",
        isDarkCard
          ? "border-white/15 bg-white/10 text-white/80 group-hover:bg-white group-hover:text-accent"
          : "border-border bg-background text-muted-foreground group-hover:border-accent group-hover:text-accent",
      ]}
      aria-hidden="true"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 3l5 5-5 5"></path>
      </svg>
    </span>
  </div>

  <h3 class="font-heading mt-4 text-[18px] font-semibold leading-none tracking-tight">
    {name}
  </h3>
  {
    description && (
      <p class:list={["mt-2 line-clamp-2 text-sm leading-relaxed", descClasses[variant]]}>
        {description}
      </p>
    )
  }
  <p
    class:list={[
      "mt-auto pt-4 font-mono text-[11px] tracking-tight",
      domainClasses[variant],
    ]}
  >
    {domain}
  </p>
</a>

<style>
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none !important;
    }
    a:hover {
      transform: none !important;
    }
  }
</style>
