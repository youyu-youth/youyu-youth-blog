---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import SkillCard from "@/components/skills/SkillCard.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";
import skills from "@/data/skills.json";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.skillsTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.skillsTitle} pageDesc={t.pages.skillsDesc}>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map(s => (
          <li>
            <SkillCard {...s} />
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
