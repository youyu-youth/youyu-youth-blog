---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import SkillCard from "@/components/skills/SkillCard.astro";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";
import skills from "@/data/skills.json";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const total = skills.length;
const totalYears = skills.reduce((acc, s) => acc + (s.years ?? 0), 0);
const topCount = skills.filter(s => s.level === 5).length;
const maxYears = Math.max(...skills.map(s => s.years ?? 0));

type Variant = "accent" | "inverted" | "muted" | "card";
const variants: Variant[] = [
  "accent",
  "card",
  "card",
  "inverted",
  "card",
  "muted",
  "card",
  "card",
];
const spans = [
  "md:col-span-8",
  "md:col-span-4",
  "md:col-span-4",
  "md:col-span-8",
  "md:col-span-7",
  "md:col-span-5",
  "md:col-span-5",
  "md:col-span-7",
];

const sortedByYears = [...skills].sort((a, b) => (b.years ?? 0) - (a.years ?? 0));
---

<Layout title={`${t.pages.skillsTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-10">
    <!-- Hero: Asymmetric split -->
    <section class="grid grid-cols-1 gap-8 border-b border-border pb-8 lg:grid-cols-12 lg:gap-6 lg:pb-10">
      <div class="flex flex-col gap-3 lg:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
          Stack inventory
        </p>
        <h1 class="font-heading text-4xl font-semibold leading-none tracking-tighter lg:text-[44px]">
          {t.pages.skillsTitle}
        </h1>
        <p class="max-w-[52ch] text-[15px] leading-relaxed text-muted-foreground">
          {t.pages.skillsDesc}
        </p>
      </div>
      <div class="grid grid-cols-3 gap-3 lg:col-span-5">
        <div class="rounded-lg border border-border bg-card p-4">
          <p class="font-mono text-xs text-muted-foreground">
            {locale === "zh" ? "技能数" : "Items"}
          </p>
          <p class="font-heading mt-2 text-3xl font-semibold leading-none tracking-tighter">
            {total}
          </p>
          <p class="mt-1 font-mono text-xs text-muted-foreground">
            {locale === "zh" ? "项核心栈" : "core stack"}
          </p>
        </div>
        <div class="rounded-lg border border-border bg-card p-4">
          <p class="font-mono text-xs text-muted-foreground">
            {locale === "zh" ? "累计" : "Years"}
          </p>
          <p class="font-heading mt-2 text-3xl font-semibold leading-none tracking-tighter">
            {totalYears}
          </p>
          <p class="mt-1 font-mono text-xs text-muted-foreground">
            {locale === "zh" ? "年经验" : "years total"}
          </p>
        </div>
        <div class="rounded-lg bg-accent p-4 text-accent-foreground">
          <p class="font-mono text-xs text-accent-foreground/80">
            Top
          </p>
          <p class="font-heading mt-2 text-3xl font-semibold leading-none tracking-tighter">
            {topCount}
          </p>
          <p class="mt-1 font-mono text-xs text-accent-foreground/80">
            {locale === "zh" ? "项精通" : "mastered"}
          </p>
        </div>
      </div>
    </section>

    <!-- Bento Grid -->
    <section class="mt-10">
      <div class="max-w-[52ch]">
        <h2 class="font-heading text-2xl font-semibold tracking-tight">
          {locale === "zh" ? "核心能力" : "Core stack"}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          {
            locale === "zh"
              ? "按熟练度与投入年限排序，最常用的排在前面。卡片深色代表高频使用。"
              : "Sorted by proficiency and years in use. Darker cards are daily drivers."
          }
        </p>
      </div>
      <ul class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-12">
        {
          skills.map((s, i) => (
            <li class:list={["flex", spans[i]]}>
              <div class="w-full">
                <SkillCard {...s} variant={variants[i]} />
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Years matrix: distinct layout family (split editorial, not bento) -->
    <section class="mt-16 border-t border-border pt-10">
      <div class="max-w-[52ch]">
        <h2 class="font-heading text-2xl font-semibold tracking-tight">
          {locale === "zh" ? "时间沉淀" : "Time invested"}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          {
            locale === "zh"
              ? "年限不等于精通度，但能看出长期投入的方向。右侧按年限排序。"
              : "Years show long term focus. Right side sorted by time invested."
          }
        </p>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <div class="rounded-lg border border-border bg-card p-6">
            <p class="font-mono text-xs text-muted-foreground">
              {locale === "zh" ? "累计投入" : "Total time"}
            </p>
            <div class="mt-3 flex items-baseline gap-3">
              <span class="font-heading text-5xl font-semibold tracking-tighter">
                {totalYears}
              </span>
              <span class="font-mono text-sm text-muted-foreground">
                {locale === "zh" ? "年" : "years"}
              </span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
              {
                locale === "zh"
                  ? "TypeScript 与 Tailwind 是日常高频工具，Astro 与 React 支撑站点与产品迭代。"
                  : "TypeScript and Tailwind are daily drivers. Astro and React power site and product iterations."
              }
            </p>
            <div class="mt-6 flex gap-2">
              <a
                href={getRelativeLocaleUrl(locale, "projects")}
                class="inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-foreground transition hover:opacity-90 active:scale-[0.98]"
              >
                {locale === "zh" ? "查看项目" : "View projects"}
              </a>
              <a
                href={getRelativeLocaleUrl(locale, "about")}
                class="inline-flex items-center rounded-lg border border-border px-4 py-2 text-sm font-medium transition hover:bg-muted active:scale-[0.98]"
              >
                {locale === "zh" ? "关于我" : "About me"}
              </a>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-lg bg-muted p-4">
              <p class="font-mono text-xs text-muted-foreground">
                {locale === "zh" ? "平均年限" : "Average"}
              </p>
              <p class="font-heading mt-1 text-xl font-semibold tracking-tight">
                {(totalYears / total).toFixed(1)} {locale === "zh" ? "年" : "y"}
              </p>
            </div>
            <div class="rounded-lg border border-border bg-card p-4">
              <p class="font-mono text-xs text-muted-foreground">
                {locale === "zh" ? "最久" : "Longest"}
              </p>
              <p class="font-heading mt-1 text-xl font-semibold tracking-tight">
                {maxYears} {locale === "zh" ? "年" : "y"}
              </p>
            </div>
          </div>
        </div>
        <div class="lg:col-span-7">
          <ul class="flex flex-col gap-4">
            {
              sortedByYears.map(s => {
                const width = maxYears > 0 ? ((s.years ?? 0) / maxYears) * 100 : 0;
                return (
                  <li class="rounded-lg border border-border bg-card p-4">
                    <div class="flex items-center justify-between gap-4">
                      <span class="font-heading text-sm font-semibold tracking-tight">
                        {s.name}
                      </span>
                      <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
                        {tplStr(t.skills.years, { n: s.years ?? 0 })}
                      </span>
                    </div>
                    <div class="mt-3 h-1.5">
                      <div
                        class="h-full rounded-full bg-accent transition-all duration-700"
                        style={`width: ${width}%`}
                      />
                    </div>
                    <div class="mt-2 flex items-center justify-between">
                      <span class="font-mono text-xs text-muted-foreground">
                        {s.desc}
                      </span>
                      <span class="font-mono text-xs tabular-nums text-muted-foreground">
                        {s.level}/5
                      </span>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
