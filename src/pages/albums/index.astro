---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import AlbumCard from "@/components/albums/AlbumCard.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const albums = await getCollection("albums", ({ data }) => !data.draft);
const sorted = albums.sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.albumsTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-4">
    {
      sorted.length === 0 ? (
        <p class="text-muted-foreground">{t.albums.empty}</p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {sorted.map(a => (
            <li>
              <AlbumCard {...a} />
            </li>
          ))}
        </ul>
      )
    }
  </main>
  <Footer />
</Layout>
